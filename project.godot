; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="m3d3"
run/main_scene="res://zones/overworld/overworld.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/max_fps=60

[autoload]

GameState="*res://game/game_state.gd"
ZoneManager="*res://game/zone_manager.gd"
Talk="*res://game/story/talk.gd"
Schedules="*res://game/story/schedule/schedules.gd"
Cutscenes="*res://game/story/cutscene/cutscenes.gd"
RenderScale="*res://game/render_scale.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="m3d3"

[editor_plugins]

enabled=PackedStringArray("res://addons/n64_actor_tools/plugin.cfg", "res://addons/n64_audio_tools/plugin.cfg", "res://addons/n64_grade/plugin.cfg", "res://addons/n64_level_tools/plugin.cfg", "res://addons/n64_script_builder/plugin.cfg", "res://addons/n64_story_tools/plugin.cfg", "res://addons/zz_view_debug/plugin.cfg")

[n64]

build/lod_distance=25.0
build/ground_lod_distance=30.0
build/chunk_size=64.0
build/lod_cell_size=32.0
build/unseen_cull=true
textures/texels_per_metre=16
render/target_lines=900
render/integer_scale=true
render/edge_upscale=false

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

lights_and_shadows/directional_shadow/size=1024
anti_aliasing/quality/msaa_3d=2
occlusion_culling/use_occlusion_culling=true
lights_and_shadows/positional_shadow/atlas_size=1024
m3d3/vi_upscale=true
m3d3/keep_coverage_alpha=true

[shader_globals]

n64_print_rect={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
n64_ripple_rect={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
n64_rain_cover={
"type": "sampler2D",
"value": ""
}
n64_rain_cover_area={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
n64_rain_cover_height={
"type": "vec2",
"value": Vector2(0, 1)
}
n64_rain_light={
"type": "sampler2D",
"value": ""
}
n64_rain_light_area={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
n64_rain_light_dims={
"type": "vec4",
"value": Vector4(1, 1, 1, 0)
}
n64_rain_light_keys={
"type": "vec4",
"value": Vector4(1, 1, 1, 1)
}
n64_rain={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
n64_wind={
"type": "vec4",
"value": Vector4(1, 0, 0.35, 0.5)
}
