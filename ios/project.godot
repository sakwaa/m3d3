n64_fog={
"type": "vec4",
"value": Vector4(10, 60, 0, 0)
}
n64_fog_origin={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
n64_key_light={
"type": "vec4",
"value": Vector4(0.3, 0.9, 0.3, 0.6)
}
n64_fog_light_pos0={
"type": "vec4",
"value": Vector4(0, -10000, 0, 0)
}
n64_fog_light_col0={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
n64_fog_light_pos1={
"type": "vec4",
"value": Vector4(0, -10000, 0, 0)
}
n64_fog_light_col1={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
n64_fog_light_pos2={
"type": "vec4",
"value": Vector4(0, -10000, 0, 0)
}
n64_fog_light_col2={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
n64_fog_light_pos3={
"type": "vec4",
"value": Vector4(0, -10000, 0, 0)
}
n64_fog_light_col3={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
