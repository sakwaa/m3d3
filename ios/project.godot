; M3D3 Mesh Builder: a touch-first iOS app for building the game's low-poly models.
; Its own small GDScript-only project (exports to iOS like any Godot app); the modelling
; code, textures and characters are symlinks into the main project (same res:// paths),
; so the app and the desktop editor share code and files. The main project ignores this
; folder (it has its own project.godot).

config_version=5

[application]

config/name="M3D3 Mesh Builder"
run/main_scene="res://app/mesh_builder.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1170
window/size/viewport_height=2532
window/size/window_width_override=468
window/size/window_height_override=1013
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="mobile"
textures/canvas_textures/default_texture_filter=0

[shader_globals]

n64_rain_cover={
"type": "sampler2D",
"value": ""
}
n64_rain_cover_area={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
n64_rain_cover_height={
"type": "vec2",
"value": Vector2(0, 1)
}
n64_rain_light={
"type": "sampler2D",
"value": ""
}
n64_rain_light_area={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
n64_rain_light_dims={
"type": "vec4",
"value": Vector4(1, 1, 1, 0)
}
n64_rain_light_keys={
"type": "vec4",
"value": Vector4(1, 1, 1, 1)
}
n64_rain={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
n64_wetness={
"type": "float",
"value": 0.0
}
n64_light_blend={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
n64_ambient_light={
"type": "color",
"value": Color(1, 1, 1, 1)
}
n64_world_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}
n64_weather_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}
n64_vertex_ao={
"type": "float",
"value": 1.0
}
