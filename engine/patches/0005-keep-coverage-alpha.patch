 	GLOBAL_DEF("rendering/m3d3/vi_upscale", false);
+	// m3d3 patch (coverage for see-through surfaces): blended 3D surfaces keep the colour
+	// buffer's alpha (the coverage tags). Off for viewports that need a transparent background.
+	GLOBAL_DEF_RST("rendering/m3d3/keep_coverage_alpha", false);
 	GLOBAL_DEF(PropertyInfo(Variant::FLOAT, "rendering/scaling_3d/fsr_sharpness", PROPERTY_HINT_RANGE, "0,2,0.01"), 0.2f);
 
