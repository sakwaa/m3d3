+void RendererSceneCull::camera_set_clip_plane(RID p_camera, const Plane &p_plane, bool p_enabled) {
+	Camera *camera = camera_owner.get_or_null(p_camera);
+	ERR_FAIL_NULL(camera);
+	camera->clip_plane = p_plane;
+	camera->clip_enabled = p_enabled;
+}
+
+// m3d3: the projection's near plane moved onto `p_view_plane` (view space, normal side kept,
+// the camera behind it) - Lengyel, "Oblique View Frustum Depth Projection and Clipping".
+// Godot's projection is OpenGL style here (depth -1..1; reversed later).
+static void _m3d3_oblique(Projection &r_proj, const Plane &p_view_plane) {
+	Vector4 c(p_view_plane.normal.x, p_view_plane.normal.y, p_view_plane.normal.z, -p_view_plane.d);
+	Vector4 q;
+	q.x = (SIGN(c.x) + r_proj.columns[2][0]) / r_proj.columns[0][0];
+	q.y = (SIGN(c.y) + r_proj.columns[2][1]) / r_proj.columns[1][1];
+	q.z = -1.0;
+	q.w = (1.0 + r_proj.columns[2][2]) / r_proj.columns[3][2];
+	real_t dq = c.dot(q);
+	if (Math::abs(dq) < CMP_EPSILON) {
+		return;
+	}
+	c *= 2.0 / dq;
+	r_proj.columns[0][2] = c.x - r_proj.columns[0][3];
+	r_proj.columns[1][2] = c.y - r_proj.columns[1][3];
+	r_proj.columns[2][2] = c.z - r_proj.columns[2][3];
+	r_proj.columns[3][2] = c.w - r_proj.columns[3][3];
+}
